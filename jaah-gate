#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

run_quick() {
  git diff --check
  git diff --cached --check
  bash -n ./jaah-gate
  npm run lint
  npm run typecheck
}

case "${1:-}" in
  quick)
    run_quick
    ;;
  full)
    run_quick
    git show --check --format=oneline HEAD
    npm run test:setup
    npm test
    npm run build
    ;;
  *)
    printf 'Usage: ./jaah-gate {quick|full}\n' >&2
    exit 2
    ;;
esac
